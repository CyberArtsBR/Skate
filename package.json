    "check:contact": "node checks/contact-clearance.mjs",
    "check:visual-contact": "node checks/visual-contact.mjs",
    "check:pumping": "node checks/passive-physics.mjs",
    "check:session": "node checks/session.mjs",
    "check:controller": "node checks/controller-input.mjs",
    "check:camera": "node checks/camera-framing.mjs",
    "check:tricks": "node checks/trick-presentation.mjs && node checks/phase4-character-tricks.mjs"
