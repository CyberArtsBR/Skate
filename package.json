{
  "name": "chimpions-halfpipe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:release",
    "check:browser": "node checks/browser-release-current.mjs",
    "check:browser:legacy": "node checks/browser-smoke.mjs",
    "audit:assets": "node tools/inspect-glb.mjs",
    "check:gameplay:current": "node checks/gameplay-current.mjs",
    "check:phase3": "node checks/phase3-decomposition.mjs",
    "check:physics": "node checks/passive-physics.mjs",
    "check:physics:legacy": "node checks/passive-physics.mjs",
    "check:contact": "node checks/contact-clearance.mjs",
    "check:visual-contact": "node checks/visual-contact.mjs",
    "check:coping-glow": "node checks/coping-glow.mjs",
    "check:graffiti-ramp": "node checks/graffiti-ramp.mjs",
    "check:aerial-tuck": "node checks/aerial-tuck.mjs",
    "check:presentation:browser": "node checks/presentation-style-browser.mjs",
    "check:presentation:browser:legacy": "node checks/presentation-style-browser.mjs",
    "check:pumping": "node checks/passive-physics.mjs",
    "check:session": "node checks/session.mjs",
    "check:controller": "node checks/controller-input.mjs",
    "check:camera": "node checks/camera-framing.mjs",
    "check:hud-palettes": "node checks/hud-palettes.mjs",
    "check:map-lighting": "node checks/map-lighting.mjs",
    "check:tricks": "node checks/trick-presentation.mjs",
    "check:tricks:legacy": "node checks/trick-presentation.mjs",
    "check:gameplay": "node --import ./checks/v9-runtime-preload.mjs checks/phase4-gameplay-core.mjs",
    "check:gameplay:legacy": "node --import ./checks/v9-runtime-preload.mjs checks/phase4-gameplay-core.mjs",
    "check:v9": "node checks/v9-gameplay-regressions.mjs",
    "check:v9:legacy": "node checks/v9-gameplay-regressions.mjs",
    "check:v15": "node checks/v15-pump-energy-gain.mjs",
    "check:v16:browser": "node checks/v16-browser-regressions.mjs",
    "check:character": "node checks/phase4-character-tricks.mjs",
    "check:ui": "node checks/ui-flow.mjs",
    "check:ui:legacy": "node checks/ui-flow.mjs",
    "check:integration": "node checks/phase4-integration.mjs",
    "check:integration:legacy": "node checks/phase4-integration.mjs",
    "check:phase4": "node checks/run-npm-suite.mjs check:gameplay:legacy check:character check:ui:legacy check:integration:legacy",
    "check:syntax": "node --check src/bootstrap.js && node --check src/main.js && node --check src/halfpipe/HalfpipeVisual.js && node --check src/halfpipe/HalfpipeMotionSolver.js && node --check src/halfpipe/RunStatistics.js && node --check src/v9/bootstrap.js && node --check src/v9/installHalfpipeV9GameplayPatches.js && node --check src/v9/installHalfpipeV9EventPatches.js && node --check src/v9/installHalfpipeV9RuntimePatches.js && node --check src/v16/installHalfpipeV16Patches.js && node --check src/v18/installHalfpipeV18Patches.js && node --check checks/browser-release-current.mjs && node --check checks/release-contracts-current.mjs && node --check checks/gameplay-current.mjs && node --check checks/phase3-decomposition.mjs",
    "check:contracts": "node checks/foundation-invariants.mjs && node checks/phase4-contracts.mjs && node checks/release-contracts-current.mjs",
    "check:static": "npm run check:syntax && npm run check:contracts",
    "check:browser:release": "npm run check:browser",
    "check:release:browser": "node checks/run-npm-suite.mjs check:browser check:visual-contact",
    "check:release": "node tools/run-release.mjs",
    "check:security": "npm audit --audit-level=high",
    "prebuild": "npm run verify:characters",
    "predev": "npm run verify:characters",
    "verify:characters": "node tools/verify-chimpion-roster.mjs",
    "check:rigs": "node checks/rig-compatibility.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@playwright/test": "^1.55.1",
    "vite": "7.3.5"
  }
}
