{
  "name": "chimpions-halfpipe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:release",
    "check:browser": "node checks/browser-smoke.mjs",
    "audit:assets": "node tools/inspect-glb.mjs",
    "check:physics": "node checks/passive-physics.mjs",
    "check:contact": "node checks/contact-clearance.mjs",
    "check:visual-contact": "node checks/visual-contact.mjs",
    "check:pumping": "node checks/passive-physics.mjs",
    "check:session": "node checks/session.mjs",
    "check:controller": "node checks/controller-input.mjs",
    "check:camera": "node checks/camera-framing.mjs",
    "check:tricks": "node checks/trick-presentation.mjs",
    "check:gameplay": "node checks/phase4-gameplay-core.mjs",
    "check:character": "node checks/phase4-character-tricks.mjs",
    "check:ui": "node checks/ui-flow.mjs",
    "check:integration": "node checks/phase4-integration.mjs",
    "check:phase4": "node checks/run-npm-suite.mjs check:gameplay check:character check:ui check:integration",
    "check:static": "node --check src/main.js && node checks/foundation-invariants.mjs && node checks/phase4-contracts.mjs && node checks/release-contracts.mjs && node checks/phase4-integration.mjs",
    "check:browser:release": "node checks/browser-release-smoke.mjs",
    "check:release:browser": "node checks/run-npm-suite.mjs check:browser:release check:browser check:visual-contact",
    "check:release": "node checks/run-npm-suite.mjs check:static check:physics check:contact check:session check:controller check:camera check:tricks check:gameplay check:rigs check:character check:ui check:integration build",
    "check:security": "npm audit --audit-level=high",
    "prebuild": "npm run verify:characters",
    "predev": "npm run verify:characters",
    "verify:characters": "node tools/verify-chimpion-roster.mjs",
    "check:rigs": "node checks/rig-compatibility.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@playwright/test": "^1.55.1",
    "vite": "7.3.5"
  }
}
